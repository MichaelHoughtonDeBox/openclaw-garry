# Mission Control Mongo connection string.
# Example: mongodb+srv://user:pass@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MISSION_CONTROL_MONGO_URI=

# Optional database override (default: mission-control).
MISSION_CONTROL_DB=mission-control

# Optional collection override (default: tasks).
MISSION_CONTROL_TASKS_COLLECTION=tasks

# Optional collection override (default: activities).
MISSION_CONTROL_ACTIVITIES_COLLECTION=activities

# Optional collection override (default: documents).
MISSION_CONTROL_DOCUMENTS_COLLECTION=documents

# Mission Control telemetry ingest endpoint for agent runtime events.
# Example: https://mission-control.example.com/api/telemetry/ingest
SHERLOCK_MISSION_CONTROL_TELEMETRY_URL=
# Token must match Mission Control's MISSION_CONTROL_INGEST_TOKEN.
SHERLOCK_MISSION_CONTROL_INGEST_TOKEN=
SHERLOCK_MISSION_CONTROL_TELEMETRY_TIMEOUT_MS=8000

# -------------------------------------------
# Sherlock incident discovery configuration
# -------------------------------------------

# Official X API bearer token used by Sherlock's X connector.
SHERLOCK_X_BEARER_TOKEN=

# Optional X query override for incident discovery.
SHERLOCK_X_QUERY=(crime OR robbery OR assault OR "suspicious activity") has:geo -is:retweet lang:en

# Optional focus locations for Sherlock (use || separator for multiple values).
# Example: Johannesburg, South Africa||Cape Town, South Africa||Nairobi, Kenya
SHERLOCK_FOCUS_LOCATIONS=Johannesburg, South Africa||Cape Town, South Africa||Durban, South Africa||Pretoria, South Africa||Port Elizabeth, South Africa||Bloemfontein, South Africa||Nairobi, Kenya||Mombasa, Kenya||Cairo, Egypt||Alexandria, Egypt||Lagos, Nigeria||Casablanca, Morocco||Sydney, Australia||Melbourne, Australia||Brisbane, Australia||Perth, Australia||Adelaide, Australia||Mumbai, India||Delhi, India||Bengaluru, India||Hyderabad, India||Chennai, India||Kolkata, India||Pune, India||Ahmedabad, India||London, United Kingdom||Manchester, United Kingdom||Birmingham, United Kingdom||Leeds, United Kingdom||Glasgow, United Kingdom||Liverpool, United Kingdom||Bristol, United Kingdom||Edinburgh, United Kingdom||Paris, France||Marseille, France||Berlin, Germany||Munich, Germany||Madrid, Spain||Barcelona, Spain||Rome, Italy||Milan, Italy||Amsterdam, Netherlands||Brussels, Belgium||Lisbon, Portugal||Warsaw, Poland||Prague, Czech Republic||Vienna, Austria||Athens, Greece||Stockholm, Sweden||Copenhagen, Denmark||Oslo, Norway||Zurich, Switzerland||Dublin, Ireland||New York, United States||Los Angeles, United States||Chicago, United States||Houston, United States||Miami, United States||Atlanta, United States||Seattle, United States||San Francisco, United States||Washington, United States||Toronto, Canada||Vancouver, Canada||Montreal, Canada||Calgary, Canada||Ottawa, Canada||Mexico City, Mexico||Sao Paulo, Brazil||Rio de Janeiro, Brazil||Buenos Aires, Argentina||Santiago, Chile||Bogota, Colombia||Lima, Peru||Tokyo, Japan||Osaka, Japan||Seoul, South Korea||Singapore, Singapore||Bangkok, Thailand||Jakarta, Indonesia||Manila, Philippines||Dubai, United Arab Emirates||Riyadh, Saudi Arabia||Istanbul, Turkey

# Optional X API connector tuning.
SHERLOCK_X_MAX_RESULTS=25
SHERLOCK_X_TIMEOUT_MS=15000
# Default lookback window used by XDK collector when no sinceId checkpoint exists.
SHERLOCK_X_LOOKBACK_HOURS=24
# Safety cap for how many focus locations are embedded directly into X queries.
SHERLOCK_X_FOCUS_MAX_TERMS=4
SHERLOCK_GEOCODE_TIMEOUT_MS=8000

# Perplexity connector auth options:
# - Direct Perplexity key: PERPLEXITY_API_KEY (or SHERLOCK_PERPLEXITY_API_KEY)
# - OpenRouter key when routing Perplexity models via OpenRouter: OPENROUTER_API_KEY
SHERLOCK_PERPLEXITY_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# Optional Perplexity connector tuning.
SHERLOCK_PERPLEXITY_MODEL=sonar-pro
SHERLOCK_PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
SHERLOCK_PERPLEXITY_TIMEOUT_MS=25000
SHERLOCK_PERPLEXITY_QUERIES=

# Additive Wolf ingest endpoint configuration.
SHERLOCK_WOLF_INGEST_URL=
SHERLOCK_WOLF_INGEST_TOKEN=
SHERLOCK_WOLF_PRODUCT_TYPE=community
SHERLOCK_WOLF_DISPATCH_ALERTS=false
SHERLOCK_WOLF_INGEST_TIMEOUT_MS=15000
# Minimum confidence score (0-100) required for Sherlock distribution when alerts are enabled.
# Confidence scoring and gating are enforced in the Wolf Sherlock ingest endpoint.
SHERLOCK_MIN_DISTRIBUTION_CONFIDENCE=65

# Stable reporter id used for creator-hash dedupe in Wolf.
SHERLOCK_REPORTER_ID=sherlock-agent

# Sherlock geocoding uses HERE first if HERE_API_KEY is present, then falls back to Nominatim search.
# Reuse the same HERE key used by Wolf where possible.
HERE_API_KEY=
